## ------------------------------------
## creating a command name for a script
## new_command	_my_command_name python /path/to/script.py %{file_name} %{paper_name}

new_command _add_text python3 -m sioyek.add_text %{sioyek_path} %{local_database} %{shared_database} %{file_path} %{selected_rect} %{command_text}

new_command _next_file python3 /Users/maksim/.config/sioyek/commands/next.py "%1"
new_command _prev_file python3 /Users/maksim/.config/sioyek/commands/prev.py "%1"
new_command _load_folder python3 /Users/maksim/.config/sioyek/commands/load_folder.py "%1"

new_command _theme_gruvbox_light    /Users/maksim/.config/sioyek/commands/theme_switch.sh gruvbox_light "%0"
new_command _theme_catppuccin_mocha /Users/maksim/.config/sioyek/commands/theme_switch.sh catppuccin_mocha "%0"
new_command _theme_monokai          /Users/maksim/.config/sioyek/commands/theme_switch.sh monokai "%0"
new_command _theme_solarized_light  /Users/maksim/.config/sioyek/commands/theme_switch.sh solarized_light "%0"
new_command _theme_catppuccin_latte /Users/maksim/.config/sioyek/commands/theme_switch.sh catppuccin_latte "%0"
new_command _theme_gray_5           /Users/maksim/.config/sioyek/commands/theme_switch.sh gray_5 "%0"
new_command _theme_gray_6           /Users/maksim/.config/sioyek/commands/theme_switch.sh gray_6 "%0"
new_command _theme_warm_7           /Users/maksim/.config/sioyek/commands/theme_switch.sh warm_7 "%0"
new_command _theme_terminal         /Users/maksim/.config/sioyek/commands/theme_switch.sh terminal_theme "%0"
new_command _theme_white_background /Users/maksim/.config/sioyek/commands/theme_switch.sh white_background "%0"
new_command _theme_flexoki          /Users/maksim/.config/sioyek/commands/theme_switch.sh flexoki "%0" 
new_command _theme_ash_gray         /Users/maksim/.config/sioyek/commands/theme_switch.sh ash_gray "%0" 
new_command _theme_wezterm          /Users/maksim/.config/sioyek/commands/theme_switch.sh wezterm "%0"


## ------------------------------------

touchpad_sensitivity 0.8
zoom_inc_factor 1.075

startup_commands    toggle_visual_scroll;toggle_custom_color;toggle_statusbar;toggle_titlebar;set_freehand_thickness(3)

# ----------------------------------
# theme placeholder start
# (This section will be replaced with the selected theme)
# === WHITE BACKGROUND === #
text_highlight_color       #dc8a78

search_highlight_color     #dc8a78
link_highlight_color       #1e66f5
synctex_highlight_color    #40a02b

highlight_color_a          #dc8a78
highlight_color_b          #40a02b
highlight_color_c          #04a5e5
highlight_color_d          #d20f39
highlight_color_e          #8839ef
highlight_color_f          #e64553
highlight_color_g          #dc8a78

custom_background_color    #ffffff
custom_text_color          #000000
custom_color_mode_empty_background_color #e6e9ef

ui_text_color                #4c4f69
ui_background_color          #ccd0da
ui_selected_text_color       #4c4f69
ui_selected_background_color #acb0be

status_bar_color           #ffffff
status_bar_text_color      #4c4f69
status_bar_font_size       12
# === WHITE BACKGROUND === #
# theme placeholder end
# ----------------------------------


# Fixed pen colors, independent of the selected theme.
# Preserve the original cursor path after each stroke.
simplify_freehand_drawings 0
highlight_color_r #E53935
highlight_color_g #50C878
highlight_color_n #3B82F6

new_macro _pen_red set_freehand_type(r)
new_macro _pen_green set_freehand_type(g)
new_macro _pen_blue set_freehand_type(n)

