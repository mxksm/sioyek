## ------------------------------------
# Custom commands use a shell to expand CONFIG_DIR (defaults to $HOME/.config).
# Backslash-spaces keep the shell expression together in Sioyek's command parser.
## creating a command name for a script
## new_command	_my_command_name python /path/to/script.py %{file_name} %{paper_name}

new_command _next_file /bin/sh -c exec\ python3\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/next.py"\ "$1" sioyek %{file_path}
new_command _prev_file /bin/sh -c exec\ python3\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/prev.py"\ "$1" sioyek %{file_path}
new_command _load_folder /bin/sh -c exec\ python3\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/load_folder.py"\ "$1" sioyek %{file_path}

new_command _theme_gruvbox_light /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek gruvbox_light
new_command _theme_catppuccin_mocha /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek catppuccin_mocha
new_command _theme_monokai /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek monokai
new_command _theme_solarized_light /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek solarized_light
new_command _theme_catppuccin_latte /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek catppuccin_latte
new_command _theme_gray_5 /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek gray_5
new_command _theme_gray_6 /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek gray_6
new_command _theme_warm_7 /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek warm_7
new_command _theme_terminal /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek terminal_theme
new_command _theme_white_background /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek white_background
new_command _theme_flexoki /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek flexoki
new_command _theme_ash_gray /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek ash_gray
new_command _theme_wezterm /bin/sh -c exec\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/theme_switch.sh"\ "$1" sioyek wezterm


## ------------------------------------

touchpad_sensitivity 0.8

# Keep keyboard zoom steps at 5%, independent of the bundled defaults.
zoom_inc_factor 1.05

restore_all_windows_on_startup 1
startup_commands    toggle_visual_scroll;toggle_custom_color;toggle_statusbar;set_freehand_thickness(3)

# ----------------------------------
# theme placeholder start
# (This section will be replaced with the selected theme)
# === FLEXOKI THEME === #
text_highlight_color        #CE5D97
search_highlight_color      #DA702C
link_highlight_color        #3AA99F
synctex_highlight_color     #4385BE

highlight_color_a           #D14D41
highlight_color_b           #879A39
highlight_color_c           #3AA99F
highlight_color_d           #DA702C
highlight_color_e           #8B7EC8
highlight_color_f           #D0A215
highlight_color_g           #CECDC3

# --- backgrounds ---
custom_background_color     #100F0F
custom_color_mode_empty_background_color #1C1B1A

# --- text ---
custom_text_color           #CECDC3
ui_text_color               #CECDC3
ui_selected_text_color      #FFFCF0

# --- UI chrome ---
ui_background_color         #282726
ui_selected_background_color #205EA6

status_bar_color           #100F0F
status_bar_text_color      #CECDC3
status_bar_font_size       12
# === FLEXOKI THEME === #
# theme placeholder end
# ----------------------------------

# Muted blue for new text boxes; kept outside the replaceable theme section.
freetext_bookmark_color #527A9E

# Pen colors stay fixed across themes (shared highlight slots r and n).
# Preserve the original cursor path instead of simplifying finished strokes.
simplify_freehand_drawings 0
# Edit these hex values to customize the red and blue pens.
highlight_color_r #E53935
highlight_color_g #50C878
highlight_color_n #3B82F6

new_macro _pen_red set_freehand_type(r)
new_macro _pen_green set_freehand_type(g)
new_macro _pen_blue set_freehand_type(n)
# Option+W prompts for pen width, e.g. 1 (thin), 2, or 4 (thick).
