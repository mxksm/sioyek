## ------------------------------------
# Custom commands use a shell to expand CONFIG_DIR (defaults to $HOME/.config).
# Backslash-spaces keep the shell expression together in Sioyek's command parser.
## creating a command name for a script
## new_command	_my_command_name python /path/to/script.py %{file_name} %{paper_name}

new_command _next_file /bin/sh -c exec\ python3\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/next.py"\ "$1" sioyek %{file_path}
new_command _prev_file /bin/sh -c exec\ python3\ "${CONFIG_DIR:-$HOME/.config}/sioyek/commands/prev.py"\ "$1" sioyek %{file_path}



## ------------------------------------

touchpad_sensitivity 0.8

# Keep keyboard zoom steps at 5%, independent of the bundled defaults.
zoom_inc_factor 1.05

restore_all_windows_on_startup 1
# Allow small typos when searching documents and menus.
fuzzy_searching 1
# Highlight every visible search match, not just the active result.
should_highlight_unselected_search 1
# Shared page-image cache budget in MiB; visible pages are always retained.
render_cache_size_mb 256
# Search all PDFs in Documents and its subfolders with Command+Shift+O.
# Separate folders with semicolons, e.g. ~/Documents; ~/Downloads; ~/Books.
# Each includes its subfolders; overlapping files appear only once.
pdf_library_path ~/Documents

startup_commands    toggle_visual_scroll;toggle_custom_color;toggle_statusbar;set_freehand_thickness(3)

# Laser lifetime after releasing the mouse, in milliseconds (100–60000).
# Smaller = faster disappearance; larger = slower. Applies to the next release.
laser_pointer_duration_ms 1450

# ----------------------------------
# Load the saved palette; this is the default on a fresh install.
# The selected theme is saved in ignored theme_state, never in this file.
source_theme catppuccin_latte

# Favorite slots (Option+number). Override these in prefs_local.config.
theme_slot_1 flexoki_dark
theme_slot_2 monokai_midnight
theme_slot_3 slate
theme_slot_4 tokyo_dracula
theme_slot_5 cocoa
theme_slot_8 gruvbox_light
theme_slot_9 catppuccin_latte
theme_slot_0 paper_white
# Slots 6 and 7 are unassigned until configured locally.
new_macro _theme_slot_0 set_theme_slot(0)
new_macro _theme_slot_1 set_theme_slot(1)
new_macro _theme_slot_2 set_theme_slot(2)
new_macro _theme_slot_3 set_theme_slot(3)
new_macro _theme_slot_4 set_theme_slot(4)
new_macro _theme_slot_5 set_theme_slot(5)
new_macro _theme_slot_6 set_theme_slot(6)
new_macro _theme_slot_7 set_theme_slot(7)
new_macro _theme_slot_8 set_theme_slot(8)
new_macro _theme_slot_9 set_theme_slot(9)
# ----------------------------------

# Compact bottom-right status; set chapter names locally if desired.
compact_status_bar 1
status_bar_show_chapter 0
# Show available continuations for Space, g, s, and other key sequences.
show_command_hints 1

# Muted blue for new text boxes; kept independent of the selected palette.
freetext_bookmark_color #527A9E

# Pen colors stay fixed across themes (shared highlight slots r and n).
# Preserve the original cursor path instead of simplifying finished strokes.
simplify_freehand_drawings 0
# Edit these hex values to customize the red and blue pens.
highlight_color_r #E53935
highlight_color_g #50C878
highlight_color_n #3B82F6

new_macro _pen_red set_freehand_type(r)
new_macro _pen_green set_freehand_type(g)
new_macro _pen_blue set_freehand_type(n)
# Option+W prompts for pen width, e.g. 1 (thin), 2, or 4 (thick).

# Machine-specific settings, loaded last so they override the public defaults.
# This file is ignored by Git; build-sioyek.sh creates it if absent.
source ./prefs_local.config
