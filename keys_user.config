## ------------------------------------
## binding custom commands defined in prefs_user.config
## _my_command_name <unbound>

_next_file L
_prev_file D
_load_folder U

# Copy selected PDF text with Command on macOS.
copy <D-c>

_theme_flexoki <A-1>
_theme_monokai <A-2>
_theme_ash_gray <A-3>
_theme_wezterm <A-4>
_theme_gray_5 <A-5>

_theme_gruvbox_light <A-8>
_theme_catppuccin_latte <A-9>
_theme_white_background <A-0>

## ------------------------------------
# navigation

next_page d
next_page ,
previous_page l

next_page <f13>
previous_page <f14>

open_last_document a
goto_mark '

move_down j
move_up k

#move_down_smooth j
#move_up_smooth k

move_left r
move_right e

zoom_in  K
zoom_out J

## ------------------------------------
# fit to page stuff

fit_to_page_width =

fit_to_page_width;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;move_right;move_right;move_right;move_right;move_right;move_right;move_right -

fit_to_page_width;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;move_left;move_left;move_left;move_left;move_left;move_left;move_left <A-->

fit_to_page_width;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out;zoom_out <A-=>

# Fill the width, then center the page vertically (equal top/bottom space).
fit_to_page_width;center_page zz

## ------------------------------------
# misc

toggle_two_page_mode sp
toggle_statusbar sb
toggle_titlebar st

toggle_freehand_drawing_mode p
delete_freehand_drawings P
# Toggle the circular stroke eraser; p returns to drawing and Esc exits.
toggle_brush_eraser c
undo_drawing <C-z>
undo_drawing <D-z>
redo_drawing <D-Z>
_pen_red <D-r>
_pen_green <D-g>
_pen_blue <D-b>
set_freehand_thickness <A-c>

delete_bookmark wb
delete_highlight wh

add_freetext_bookmark A
delete_visible_annotation wa

# Rotate with Option; Command+R remains the red pen.
rotate_clockwise <A-r>
rotate_counterclockwise <A-R>

#toggle_reading p

move_visual_mark_up ww
move_visual_mark_down ss

quit Q

# PDF tabs (Command on macOS); Control-T still opens a separate window.
new_tab <D-t>
close_tab <D-w>
reopen_closed_tab <D-T>
# Shift+E / Shift+R: select the tab to the left / right.
goto_prev_tab E
goto_next_tab R
# Shift+comma / Shift+period: move the current tab without wrapping.
move_tab_left <less>
move_tab_right <greater>
goto_tab_1 <D-1>
goto_tab_2 <D-2>
goto_tab_3 <D-3>
goto_tab_4 <D-4>
goto_tab_5 <D-5>
goto_tab_6 <D-6>
goto_tab_7 <D-7>
goto_tab_8 <D-8>
goto_tab_9 <D-9>

# Two PDF panes sharing one tab bar; H/L for left/right, K/J for top/bottom.
toggle_split <D-\>
toggle_horizontal_split <D-|>
focus_left_pane <C-h>
focus_right_pane <C-l>
focus_top_pane <C-k>
focus_bottom_pane <C-j>
focus_other_pane <D-A-w>

# Drawing alias and temporary presentation laser (Shift+C).
toggle_freehand_drawing_mode x
toggle_laser_pointer C

# Disable inherited duplicate picker bindings.
noop O
noop <D-O>
noop <C-O>
noop <D-F>

# Save a named window layout and search saved workspaces.
save_workspace <D-S>
open_workspace <D-P>

# Find files, words, recent documents, or the current directory.
open_library <space>ff
search_library_contents <space>fw
open_prev_doc <space>fr
open_document_embedded_from_current_path <space>fd
# Ink selection and linked split navigation.
toggle_ink_lasso <A-v>
toggle_linked_navigation <D-l>

# The searchable command/shortcut picker is on colon; ? is intentionally disabled.
noop ?

# Choose a labeled PDF line to jump to LaTeX source; Cmd+click also jumps directly.
synctex_select_line sd
